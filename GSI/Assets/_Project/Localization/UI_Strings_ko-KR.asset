  - m_Id: 1522245204697263
    m_Localized: The Axiom
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697264
    m_Localized: "\uBC18\uC751\uC18D\uB3C4 \uC5F0\uC2B5"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697265
    m_Localized: "\uC5D0\uC784 \uC5F0\uC2B5"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697266
    m_Localized: "\uC5F0\uC2B5"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697267
    m_Localized: "\uC9C4\uC2E4\uC758 \uC81C\uB2E8"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697268
    m_Localized: "\uC9C4\uC2E4\uC758 \uC81C\uB2E8"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697269
    m_Localized: "\uD1B5\uD569 \uC2DC\uD5D8 \uAE30\uB85D\uC774 \uC544\uC9C1 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697270
    m_Localized: "\uBAA9\uB85D\uC5D0\uC11C \uC751\uC2DC \uAE30\uB85D\uC744 \uC120\uD0DD\uD558\uBA74 \uC0C1\uC138 \uACB0\uACFC\uAC00 \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697271
    m_Localized: "\uC751\uC2DC \uC644\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697272
    m_Localized: "\uC0C1\uC138 \uACB0\uACFC"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697273
    m_Localized: The Axiom
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697274
    m_Localized: "\uC5F0\uC2B5: \uCD08\uB2F9 \uD074\uB9AD (CPS)"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697275
    m_Localized: "\uCD08\uB2F9 \uD074\uB9AD (CPS)"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697276
    m_Localized: CPS
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697277
    m_Localized: "\uCD08\uB2F9 \uD074\uB9AD (CPS)"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697278
    m_Localized: "10\uCD08 \uB3D9\uC548 \uD070 \uB9C1\uD06C \uC601\uC5ED\uC744 \uCD5C\uB300\uD55C \uBE60\uB974\uAC8C \uB20C\uB7EC \uC8FC\uC138\uC694. \uB9C1\uD06C\uC5D0 \uD3EC\uD568\uB41C \uD074\uB9AD\uB9CC \uC9D1\uACC4\uB429\uB2C8\uB2E4. \uC810\uC218\uB294 \uD3C9\uADE0 \uCD08\uB2F9 \uD074\uB9AD \uC218(\uCD1D \uD074\uB9AD/10) \uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697279
    m_Localized: "CPS \uC5F0\uC2B5"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697280
    m_Localized: "\uACF5\uC2DD CPS \uC2DC\uD5D8"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697281
    m_Localized: "\uD3C9\uADE0: {0:F2} \uD074\uB9AD/\uCD08 (10\uCD08)\n{1}\uAE09 \uD569\uACA9: {2:F2} /\uCD08 \uC774\uC0C1\nTIER: {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697282
    m_Localized: "\uBD88\uD569\uACA9\n\uD3C9\uADE0 {0:F2} /\uCD08 (\uD569\uACA9 {1:F2} /\uCD08 \uC774\uC0C1)"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697283
    m_Localized: "{0} | {1:F0}\uC810 | {2:F2} /\uCD08 (\uD544\uC694 {3:F2}) | {4}"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697284
    m_Localized: "\uB0A8\uC740 {0:0.0}\uCD08 | \uD074\uB9AD {1} | \uD3C9\uADE0 {2:0.00} /\uCD08"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697285
    m_Localized: "\uC5EC\uAE30\uB97C \uD074\uB9AD"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697286
    m_Localized: "\uAC8C\uC784 \uC885\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697287
    m_Localized: "\uBCC4\uAC00\uB8E8\uAC00 \uBD80\uC871\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697288
    m_Localized: "\uC751\uC2DC\uAD8C\uC774 \uBD80\uC871\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697289
    m_Localized: "\uC11C\uBE44\uC2A4\uAC00 \uC544\uC9C1 \uC900\uBE44\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uB2E4\uC2DC \uC2DC\uB3C4\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697290
    m_Localized: "\uC544\uC9C1 \uBCF4\uC720\uD558\uC9C0 \uC54A\uC740 \uC2A4\uD0A8\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697291
    m_Localized: "\uD574\uC0C1\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697292
    m_Localized: "\uD654\uBA74 \uBAA8\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697293
    m_Localized: "\uC804\uCCB4 \uD654\uBA74"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697294
    m_Localized: "\uD14C\uB450\uB9AC \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697295
    m_Localized: "\uCC3D \uBAA8\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697296
    m_Localized: "\uD2B8\uB808\uC774 \uBAA8\uB4DC\uB85C \uCD5C\uC18C\uD654"
    m_Metadata:
      m_Items: []
