  - m_Id: 1522245204697132
    m_Localized: "{0}\uAE09 \uC2DC\uD5D8, \uCD1D\uC810 {1:F1} / 700"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697133
    m_Localized: "\uCD5C\uC885 \uAE30\uC900 {0:F0}\uC810 \uC774\uC0C1, {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697134
    m_Localized: "\uCD5C\uC885 \uD569\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697135
    m_Localized: "\uCD5C\uC885 \uBD88\uD569\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697136
    m_Localized: "[ \uACFC\uBAA9\uBCC4 ]"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697137
    m_Localized: "REWARD: +{0} \uBCC4\uAC00\uB8E8 (\uD2F0\uC5B4 {1})"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697138
    m_Localized: "REWARD: 0 \uBCC4\uAC00\uB8E8 (\uCD5C\uC885 \uBD88\uD569\uACA9)"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697139
    m_Localized: "FAILED\n\uBC18\uC751 {0:F0} ms (\uD569\uACA9: {1:F0} ms \uC774\uD558)"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697140
    m_Localized: "FAILED\n\uC5D0\uC784 {0:F2}\uCD08 (\uD569\uACA9: {1:F1}\uCD08 \uC774\uD558)"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697141
    m_Localized: "REWARD: 0 \uBCC4\uAC00\uB8E8"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697142
    m_Localized: "\uCD5C\uC0C1"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697143
    m_Localized: "\uC0C1"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697144
    m_Localized: "\uC911"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697145
    m_Localized: "\uD558"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697146
    m_Localized: "\uC785\uBB38"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697147
    m_Localized: "\uD45C\uC2DC\uB41C \uB300\uC0C1\uC744 \uAE30\uC5B5\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697148
    m_Localized: "\uCD94\uC801 \uC911... (\uBAA8\uB450 \uAC19\uC740 \uBAA8\uC591\uC785\uB2C8\uB2E4)"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697149
    m_Localized: "\uCD94\uC801\uD588\uB358 \uB300\uC0C1\uC744 \uB20C\uB7EC \uACE0\uB974\uC138\uC694 (\uCD5C\uB300 {0}\uAC1C). [\uC81C\uCD9C]\uC740 \uC5B8\uC81C \uB20C\uB7EC\uB3C4 \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697150
    m_Localized: "\uC120\uD0DD {0} / {1}\uAC1C, [\uC81C\uCD9C]\uC73C\uB85C \uB05D\uB0C9\uB2C8\uB2E4 (\uC77C\uBD80\uB9CC \uACE0\uB978 \uAC83\uB3C4 OK)"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697151
    m_Localized: "\uC81C\uCD9C"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697152
    m_Localized: "\uC900\uBE44..."
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697153
    m_Localized: "\uC2DC\uC791!"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697154
    m_Localized: "\uBBF8\uC2A4!"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697155
    m_Localized: "\uC624\uCC28(ms) \uAE30\uB85D \uC911...  \uC131\uACF5 {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697156
    m_Localized: "\uD37C\uD399\uD2B8!"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697157
    m_Localized: "\uADF8\uB808\uC774\uD2B8!"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697158
    m_Localized: "\uAD7D!"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697159
    m_Localized: "\uC21C\uC11C\uB97C \uAE30\uC5B5\uD55C \uB4A4, \uBCF4\uC5EC\uC900 \uC21C\uC11C\uB300\uB85C \uB20C\uB7EC\uC8FC\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697160
    m_Localized: "\uC2DC\uC791\uD558\uB824\uBA74 \uD654\uBA74 \uC544\uBB34 \uACF3\uC774\uB098 \uB20C\uB7EC\uC8FC\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697161
    m_Localized: "\uC2DC\uD5D8"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697162
    m_Localized: "\uD654\uBA74 \uC544\uBB34 \uACF3\uC774\uB098 \uB20C\uB7EC \uC2DC\uC791\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697163
    m_Localized: "\uD1B5\uD569 \uC2DC\uD5D8 \u2014 \uACFC\uBAA9 {0}/7"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697164
    m_Localized: "\uBC18\uC751 \uC18D\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697165
    m_Localized: "\uC790\uADC0\uAC00 \uB098\uD0C0\uB0A0 \uB54C\uAE4C\uC9C0 \uAE30\uB2E4\uB838\uB2E4\uAC00, \uB098\uD0C0\uB098\uBA74 \uCD5C\uB300\uD55C \uBE60\uB974\uAC8C \uBC18\uC751\uD558\uC138\uC694. \uB108\uBB34 \uC774\uB978 \uBC18\uC751\uC740 \uBD88\uB9AC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697166
    m_Localized: "\uC870\uC900 \uC815\uD655\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697167
    m_Localized: "\uD544\uB4DC\uC5D0 \uD0C0\uACA9\uC774 \uB098\uD0C0\uB0A9\uB2C8\uB2E4. \uACFC\uC81C\uC5D0 \uB9DE\uAC8C \uAC01 \uD0C0\uACA9\uC744 \uC815\uD655\uD558\uACE0 \uBE60\uB974\uAC8C \uB20C\uB7EC\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697168
    m_Localized: "\uAE30\uC5B5 \uC21C\uC11C"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697169
    m_Localized: "\uBCF4\uC5EC\uC900 \uC591\uC2DD\uC774\uB098 \uC21C\uC11C\uB97C \uAE30\uC5B5\uD55C \uB4A4, \uC2DC\uAC04 \uC548\uC5D0 \uB2E4\uC2DC \uB9DE\uCD94\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697170
    m_Localized: "\uB9AC\uB4EC \uD0C0\uC774\uBC0D"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697171
    m_Localized: "\uB9AC\uB4EC \uC2E0\uD638\uB97C \uB530\uB77C\uAC00\uC138\uC694. \uD0C0\uC774\uBC0D \uC624\uCC28\uAC00 \uACB0\uACFC\uB97C \uACB0\uC815\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697172
    m_Localized: "\uB2E4\uC911 \uAC1D\uCCB4 \uCD94\uC801(MOT)"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697173
    m_Localized: "\uD45C\uC2DC\uB41C \uAC1D\uCCB4\uB97C \uC6C0\uC9C1\uC784\uC5D0 \uB530\uB77C \uCD94\uC801\uD558\uACE0, \uC9C8\uBB38\uC774 \uC788\uC744 \uB54C \uADF8\uAC83\uB4E4\uC744 \uC9C0\uC815\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697174
    m_Localized: "\uD0C4\uB9F9"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697175
    m_Localized: "\uD22C\uC0AC\uCCB4\uB97C \uD53C\uD558\uACE0 \uCD5C\uB300\uD55C \uC624\uB798 \uC0DD\uC874\uD558\uC138\uC694. \uC774\uB3D9\uC740 \uD50C\uB808\uC774 \uC601\uC5ED \uC548\uC5D0\uC11C\uB9CC \uAC00\uB2A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697176
    m_Localized: "\uC778\uBCA4\uD1A0\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697177
    m_Localized: "\uC5B8\uC5B4"
    m_Metadata:
