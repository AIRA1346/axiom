  - m_Id: 1522245204697102
    m_Localized: "\uC5F0\uC2B5: \uB2E4\uC911 \uCD94\uC801"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697103
    m_Localized: "\uC5F0\uC2B5: Bullet Hell"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697104
    m_Localized: "\uC5F0\uC2B5 \uAE09\uC218: 1\uAE09\uC774 \uAC00\uC7A5 \uC5B4\uB835\uACE0, 9\uAE09\uC774 \uAC00\uC7A5 \uC27D\uC2B5\uB2C8\uB2E4 (\uACFC\uBAA9\uB9C8\uB2E4 \uB2E4\uB984)"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697105
    m_Localized: "\uD1B5\uD569 \uACF5\uC2DD \uC2DC\uD5D8"
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697106
    m_Localized: "7\uACFC\uBAA9\uC740 \uBB34\uC791\uC704 \uC21C\uC11C\uC785\uB2C8\uB2E4. \uC544\uB798\uC5D0\uC11C \uACE0\uB978 \uAE09\uC218\uC5D0 \uB530\uB77C \uD569\uACA9\uC120\uACFC \uCD5C\uC885 \uCD1D\uC810 \uAE30\uC900\uC774 \uC815\uD574\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1522245204697107
    m_Localized: "\uD1B5\uD569 \uACF5\uC2DD \uC2DC\uD5D8 \uC2DC\uC791 (\uC751\uC2DC\uAD8C 1\uC7A5 \uC18C\uBAA8)"
    m_Metadata:
      m_Items: []
